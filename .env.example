# An example configuration file for Helpt-UI which specifies
# all the required configuration keys.
#
# Copy this to .env and edit. Note: running pnpm start
# copies .env.example to .env if .env is missing.
#
# The URL of the helpt API without trailing slash
# Defaults to
API_URL=https://api.hel.fi/servicemap/v2

# Cloud Sentry (https://city-of-helsinki.sentry.io/) configuration.
# Sentry stays disabled unless REACT_APP_SENTRY_DSN is set.
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=local
REACT_APP_SENTRY_RELEASE=
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0
REACT_APP_SENTRY_TRACE_PROPAGATION_TARGETS=
REACT_APP_SENTRY_PROFILES_SAMPLE_RATE=0
# Session Replay: keep at 0 (org policy disables it; see README)
REACT_APP_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
REACT_APP_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
