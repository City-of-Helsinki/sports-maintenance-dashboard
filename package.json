{
  "private": true,
  "version": "1.2.0",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=24"
  },
  "description": "Pulkka UI - A user interface for storing observations with timestamps",
  "main": "",
  "scripts": {
    "build": "pnpm dist",
    "clean": "find dist -mindepth 1 -not -name 'README.md' -delete 2>/dev/null || true",
    "dist": "vite build",
    "update-runtime-env": "node scripts/update-runtime-env.mts",
    "lint": "eslint ./src",
    "typecheck": "tsc --noEmit",
    "posttest": "pnpm run lint",
    "prepare": "husky",
    "release:major": "pnpm version major && pnpm publish && git push --follow-tags",
    "release:minor": "pnpm version minor && pnpm publish && git push --follow-tags",
    "release:patch": "pnpm version patch && pnpm publish && git push --follow-tags",
    "serve": "vite",
    "serve:dist": "vite preview",
    "start": "vite",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "repository": "",
  "keywords": [],
  "author": "Timo Tuominen <tituomin@gmail.com>",
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "autoprefixer": "^10.4.19",
    "bootstrap-sass": "^3.4.3",
    "core-js": "^3.37.1",
    "hds-react": "6.0.5",
    "history": "^5.3.0",
    "jquery": "^3.7.1",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "normalize.css": "^8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "redux": "^5.0.1",
    "redux-actions": "^3.0.0",
    "redux-persist": "^6.0.0",
    "redux-promise": "^0.6.0",
    "sass": "^1.77.4",
    "urijs": "^1.19.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.24.7",
    "@babel/plugin-proposal-decorators": "^7.24.7",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.28.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-redux": "^7.1.34",
    "@types/redux": "^3.6.31",
    "@types/redux-actions": "^2.6.5",
    "@types/urijs": "^1.19.26",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "browserslist": [
    "defaults"
  ]
}
